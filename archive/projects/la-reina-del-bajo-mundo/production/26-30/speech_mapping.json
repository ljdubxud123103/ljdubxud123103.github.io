[
  {
    "source_index": 279,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Última vuelta.",
    "start": 0.2,
    "end": 1.3,
    "shot_anchor": 1,
    "estimated_words": 2,
    "storyboard": "26-1A"
  },
  {
    "source_index": 281,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Está ganando tiempo.",
    "start": 3.1,
    "end": 4.6,
    "shot_anchor": 2,
    "estimated_words": 3,
    "storyboard": "26-1A"
  },
  {
    "source_index": 296,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Tú... tú no puedes probar nada.",
    "start": 6.1,
    "end": 9.6,
    "shot_anchor": 3,
    "estimated_words": 6,
    "storyboard": "26-2A"
  },
  {
    "source_index": 299,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Incendio por el seguro. Quinientos mil pesos por una niña. Ese caso nunca se cerró.",
    "start": 9.8,
    "end": 16.5,
    "shot_anchor": 4,
    "estimated_words": 15,
    "storyboard": "26-2A"
  },
  {
    "source_index": 302,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Y la casa donde se esconden? Es de un prestamista que ni los Vargas se atreven a cruzar.",
    "start": 0.2,
    "end": 7.8,
    "shot_anchor": 1,
    "estimated_words": 18,
    "storyboard": "26-2B"
  },
  {
    "source_index": 304,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Dos opciones. La cárcel... o leen mi guion.",
    "start": 8.1,
    "end": 12.3,
    "shot_anchor": 3,
    "estimated_words": 8,
    "storyboard": "26-2B"
  },
  {
    "source_index": 306,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "¡De cualquier modo estamos muertos!",
    "start": 12.5,
    "end": 14.7,
    "shot_anchor": 4,
    "estimated_words": 5,
    "storyboard": "26-2B"
  },
  {
    "source_index": 314,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Los Vargas les pagaron quinientos mil por leer el de ellos.",
    "start": 3.1,
    "end": 7.7,
    "shot_anchor": 2,
    "estimated_words": 11,
    "storyboard": "26-3A"
  },
  {
    "source_index": 317,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Pregúntense... después de la conferencia, ¿los van a dejar gastarlo?",
    "start": 10.1,
    "end": 15.1,
    "shot_anchor": 4,
    "estimated_words": 10,
    "storyboard": "26-3A"
  },
  {
    "source_index": 327,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Mi hija Vera Saldaña...",
    "start": 3.1,
    "end": 5.5,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "27-1A"
  },
  {
    "source_index": 329,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "...es una buena chica.",
    "start": 6.1,
    "end": 8.8,
    "shot_anchor": 3,
    "estimated_words": 4,
    "storyboard": "27-1A"
  },
  {
    "source_index": 332,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Los Vargas vinieron a vernos... nos dieron quinientos mil pesos.",
    "start": 9.1,
    "end": 14.1,
    "shot_anchor": 4,
    "estimated_words": 10,
    "storyboard": "27-1A"
  },
  {
    "source_index": 334,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Nos dijeron que la llamáramos loca. Que dijéramos que ella prendió el fuego.",
    "start": 15.1,
    "end": 20.8,
    "shot_anchor": 6,
    "estimated_words": 13,
    "storyboard": "27-1A"
  },
  {
    "source_index": 336,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "¡No teníamos nada! ¡Nos usaron!",
    "start": 3.1,
    "end": 5.6,
    "shot_anchor": 2,
    "estimated_words": 5,
    "storyboard": "27-1B"
  },
  {
    "source_index": 338,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "¡Nos vamos a retractar! Ellos...",
    "start": 6.6,
    "end": 9.7,
    "shot_anchor": 3,
    "estimated_words": 5,
    "storyboard": "27-1B"
  },
  {
    "source_index": 341,
    "name": "Bárbara",
    "asset": "Bárbara常服",
    "kind": "对白",
    "text": "¡Esperen!",
    "start": 12.6,
    "end": 13.5,
    "shot_anchor": 5,
    "estimated_words": 1,
    "storyboard": "27-1B"
  },
  {
    "source_index": 351,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "No es suerte.",
    "start": 6.1,
    "end": 7.6,
    "shot_anchor": 3,
    "estimated_words": 3,
    "storyboard": "27-2A"
  },
  {
    "source_index": 353,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Nos lleva tres pasos de ventaja. Siempre.",
    "start": 9.1,
    "end": 12.4,
    "shot_anchor": 4,
    "estimated_words": 7,
    "storyboard": "27-2A"
  },
  {
    "source_index": 356,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Consígueme a Ernesto Miranda.",
    "start": 15.6,
    "end": 17.4,
    "shot_anchor": 6,
    "estimated_words": 4,
    "storyboard": "27-2A"
  },
  {
    "source_index": 358,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Dile... que tenemos un problema en común.",
    "start": 18.6,
    "end": 22.4,
    "shot_anchor": 7,
    "estimated_words": 7,
    "storyboard": "27-2A"
  },
  {
    "source_index": 366,
    "name": "Escorpión",
    "asset": "Escorpión常服",
    "kind": "对白",
    "text": "Una pregunta.",
    "start": 3.1,
    "end": 4.2,
    "shot_anchor": 2,
    "estimated_words": 2,
    "storyboard": "27-3A"
  },
  {
    "source_index": 368,
    "name": "Escorpión",
    "asset": "Escorpión常服",
    "kind": "VO",
    "text": "¿Ella es la Viuda?",
    "start": 6.1,
    "end": 7.9,
    "shot_anchor": 3,
    "estimated_words": 4,
    "storyboard": "27-3A"
  },
  {
    "source_index": 370,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Me casé con ella.",
    "start": 9.1,
    "end": 10.9,
    "shot_anchor": 4,
    "estimated_words": 4,
    "storyboard": "27-3A"
  },
  {
    "source_index": 372,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Me casé con la Viuda.",
    "start": 12.1,
    "end": 14.3,
    "shot_anchor": 5,
    "estimated_words": 5,
    "storyboard": "27-3A"
  },
  {
    "source_index": 383,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Su hijo no pudo guardársela en los pantalones.",
    "start": 3.1,
    "end": 6.5,
    "shot_anchor": 2,
    "estimated_words": 8,
    "storyboard": "28-1A"
  },
  {
    "source_index": 385,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "VO",
    "text": "Ahí empezó todo.",
    "start": 7.1,
    "end": 8.6,
    "shot_anchor": 3,
    "estimated_words": 3,
    "storyboard": "28-1A"
  },
  {
    "source_index": 387,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "对白",
    "text": "Y tú criaste un perro por veinte años que al final mordió.",
    "start": 10.1,
    "end": 15.1,
    "shot_anchor": 4,
    "estimated_words": 12,
    "storyboard": "28-1A"
  },
  {
    "source_index": 390,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "对白",
    "text": "Una declaración conjunta.",
    "start": 0.2,
    "end": 1.7,
    "shot_anchor": 1,
    "estimated_words": 3,
    "storyboard": "28-1B"
  },
  {
    "source_index": 392,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "对白",
    "text": "Matrimonio fraudulento. Extorsión. Inestabilidad mental. Vínculos con el crimen.",
    "start": 3.1,
    "end": 7.7,
    "shot_anchor": 2,
    "estimated_words": 9,
    "storyboard": "28-1B"
  },
  {
    "source_index": 395,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "VO",
    "text": "Y mi parte. El terreno sobre Reforma.",
    "start": 10.1,
    "end": 13.4,
    "shot_anchor": 4,
    "estimated_words": 7,
    "storyboard": "28-1B"
  },
  {
    "source_index": 397,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "VO",
    "text": "Tuyo... por una firma.",
    "start": 14.1,
    "end": 16.8,
    "shot_anchor": 5,
    "estimated_words": 4,
    "storyboard": "28-1B"
  },
  {
    "source_index": 419,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Vera, empecemos de nuevo.",
    "start": 3.1,
    "end": 4.9,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "29-1A"
  },
  {
    "source_index": 421,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Tú eres la Viuda, yo soy un Vargas. Juntos podríamos ser dueños de esta ciudad.",
    "start": 6.1,
    "end": 12.5,
    "shot_anchor": 3,
    "estimated_words": 15,
    "storyboard": "29-1A"
  },
  {
    "source_index": 424,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Y su compromiso con Bárbara?",
    "start": 13.1,
    "end": 15.3,
    "shot_anchor": 5,
    "estimated_words": 5,
    "storyboard": "29-1A"
  },
  {
    "source_index": 426,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Eso no fue nada. Puedo acabarlo hoy.",
    "start": 16.1,
    "end": 19.4,
    "shot_anchor": 6,
    "estimated_words": 7,
    "storyboard": "29-1A"
  },
  {
    "source_index": 428,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Te perdono. Las mentiras, la trampa, todo. No me importa.",
    "start": 0.2,
    "end": 5.0,
    "shot_anchor": 1,
    "estimated_words": 10,
    "storyboard": "29-1B"
  },
  {
    "source_index": 430,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Me perdona a MÍ?",
    "start": 5.2,
    "end": 7.0,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "29-1B"
  },
  {
    "source_index": 434,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "No se enamoró de mí. Se enamoró de sentirse vivo.",
    "start": 10.1,
    "end": 14.6,
    "shot_anchor": 4,
    "estimated_words": 10,
    "storyboard": "29-1B"
  },
  {
    "source_index": 436,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "No está aquí porque me quiera. Está aquí porque le aterra morir.",
    "start": 14.8,
    "end": 20.1,
    "shot_anchor": 5,
    "estimated_words": 12,
    "storyboard": "29-1B"
  },
  {
    "source_index": 446,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "¡Vas a desear no haberlo hecho!",
    "start": 9.1,
    "end": 11.7,
    "shot_anchor": 4,
    "estimated_words": 6,
    "storyboard": "29-2A"
  },
  {
    "source_index": 480,
    "name": "Reportera D",
    "asset": "Reportera D VO",
    "kind": "VO",
    "text": "En cuarenta y ocho horas, las familias Vargas y Miranda ofrecerán una conferencia de prensa conjunta.",
    "start": 6.1,
    "end": 12.7,
    "shot_anchor": 3,
    "estimated_words": 16,
    "storyboard": "30-2A"
  },
  {
    "source_index": 486,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "El rastro del Tejedor. Lleva diez años invisible.",
    "start": 3.1,
    "end": 6.8,
    "shot_anchor": 2,
    "estimated_words": 8,
    "storyboard": "30-2B"
  },
  {
    "source_index": 497,
    "name": "El Zorro Blanco",
    "asset": "El Zorro Blanco VO",
    "kind": "VO",
    "text": "El rastro del Tejedor. Lleva diez años invisible, pero el mes pasado salió a la superficie.",
    "start": 7.1,
    "end": 13.9,
    "shot_anchor": 3,
    "estimated_words": 16,
    "storyboard": "30-3A"
  },
  {
    "source_index": 498,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Dónde?",
    "start": 15.1,
    "end": 16.0,
    "shot_anchor": 5,
    "estimated_words": 1,
    "storyboard": "30-3A"
  },
  {
    "source_index": 499,
    "name": "El Zorro Blanco",
    "asset": "El Zorro Blanco VO",
    "kind": "VO",
    "text": "Valle de Bravo.",
    "start": 18.1,
    "end": 19.6,
    "shot_anchor": 6,
    "estimated_words": 3,
    "storyboard": "30-3A"
  }
]
