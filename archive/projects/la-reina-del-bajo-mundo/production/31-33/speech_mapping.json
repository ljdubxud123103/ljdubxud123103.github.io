  },
  {
    "source_index": 524,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "Cuarenta y ocho horas me bastan para callarlos.",
    "start": 6.1,
    "end": 9.5,
    "shot_anchor": 3,
    "estimated_words": 8,
    "storyboard": "31-2A"
  },
  {
    "source_index": 534,
    "name": "Mujer",
    "asset": "Mujer OS",
    "kind": "OS",
    "text": "Cada noche sueño que está parada junto a mi cama.",
    "start": 3.1,
    "end": 7.3,
    "shot_anchor": 2,
    "estimated_words": 10,
    "storyboard": "31-3B"
  },
  {
    "source_index": 539,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Hoy vamos a desenmascarar un fraude.",
    "start": 15.6,
    "end": 18.2,
    "shot_anchor": 6,
    "estimated_words": 6,
    "storyboard": "31-3B"
  },
  {
    "source_index": 551,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Vera Saldaña.",
    "start": 3.1,
    "end": 4.2,
    "shot_anchor": 2,
    "estimated_words": 2,
    "storyboard": "32-1A"
  },
  {
    "source_index": 553,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Mentalmente inestable. Con tendencias violentas.",
    "start": 6.1,
    "end": 8.6,
    "shot_anchor": 3,
    "estimated_words": 5,
    "storyboard": "32-1A"
  },
  {
    "source_index": 555,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "Mi hija nunca fue normal.",
    "start": 9.6,
    "end": 11.8,
    "shot_anchor": 4,
    "estimated_words": 5,
    "storyboard": "32-1A"
  },
  {
    "source_index": 557,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "Mentía, robaba, golpeaba gente. La aguantamos veinte años.",
    "start": 12.6,
    "end": 16.3,
    "shot_anchor": 5,
    "estimated_words": 8,
    "storyboard": "32-1A"
  },
  {
    "source_index": 562,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Soy su abogado.",
    "start": 0.2,
    "end": 1.7,
    "shot_anchor": 1,
    "estimated_words": 3,
    "storyboard": "32-1B"
  },
  {
    "source_index": 564,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Tiene derecho a réplica.",
    "start": 3.6,
    "end": 5.4,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "32-1B"
  },
  {
    "source_index": 567,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "Hace dos semanas… ¿qué fue lo que firmaste?",
    "start": 16.6,
    "end": 20.3,
    "shot_anchor": 6,
    "estimated_words": 8,
    "storyboard": "32-1B"
  },
  {
    "source_index": 570,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Notariada. Firmada por toda la familia Saldaña.",
    "start": 0.2,
    "end": 3.5,
    "shot_anchor": 1,
    "estimated_words": 7,
    "storyboard": "32-1C"
  },
  {
    "source_index": 572,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Declarando a la señorita Saldaña «en pleno uso de sus facultades».",
    "start": 6.1,
    "end": 10.7,
    "shot_anchor": 3,
    "estimated_words": 11,
    "storyboard": "32-1C"
  },
  {
    "source_index": 574,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "El día que se llevaron mis doscientos mil pesos, ahí sí estaba cuerda.",
    "start": 10.9,
    "end": 16.3,
    "shot_anchor": 4,
    "estimated_words": 13,
    "storyboard": "32-1C"
  },
  {
    "source_index": 576,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "Se acabó el dinero… y de pronto estoy loca.",
    "start": 17.1,
    "end": 21.2,
    "shot_anchor": 6,
    "estimated_words": 9,
    "storyboard": "32-1C"
  },
  {
    "source_index": 578,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "¿Cuerda? ¡Entonces explique ESTO!",
    "start": 3.1,
    "end": 5.2,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "32-1D"
  },
  {
    "source_index": 580,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "¡Hace diez años esta mujer no EXISTÍA!",
    "start": 6.1,
    "end": 9.1,
    "shot_anchor": 3,
    "estimated_words": 7,
    "storyboard": "32-1D"
  },
  {
    "source_index": 582,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "¡Traigan al testigo!",
    "start": 10.1,
    "end": 11.6,
    "shot_anchor": 4,
    "estimated_words": 3,
    "storyboard": "32-1D"
  },
  {
    "source_index": 596,
    "name": "Tiburcio",
    "asset": "Tiburcio常服",
    "kind": "对白",
    "text": "Hace tres años… el incendio del muelle. Yo vi con mis propios ojos cómo ella lo prendió.",
    "start": 3.1,
    "end": 10.6,
    "shot_anchor": 2,
    "estimated_words": 17,
    "storyboard": "33-1A"
  },
  {
    "source_index": 600,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "¿Usted estuvo ahí?",
    "start": 0.2,
    "end": 1.7,
    "shot_anchor": 1,
    "estimated_words": 3,
    "storyboard": "33-1B"
  },
  {
    "source_index": 602,
    "name": "Tiburcio",
    "asset": "Tiburcio常服",
    "kind": "对白",
    "text": "Sí.",
    "start": 3.1,
    "end": 4.0,
    "shot_anchor": 2,
    "estimated_words": 1,
    "storyboard": "33-1B"
  },
  {
    "source_index": 603,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "¿Hacia dónde soplaba el viento esa noche?",
    "start": 5.1,
    "end": 8.1,
    "shot_anchor": 3,
    "estimated_words": 7,
    "storyboard": "33-1B"
  },
  {
    "source_index": 605,
    "name": "Tiburcio",
    "asset": "Tiburcio常服",
    "kind": "对白",
    "text": "Hacia el norte.",
    "start": 9.1,
    "end": 10.6,
    "shot_anchor": 4,
    "estimated_words": 3,
    "storyboard": "33-1B"
  },
  {
    "source_index": 607,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "El reporte de rescate es público. El viento soplaba del SUR.",
    "start": 12.1,
    "end": 17.0,
    "shot_anchor": 5,
    "estimated_words": 11,
    "storyboard": "33-1B"
  },
  {
    "source_index": 610,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "¿De qué color era el fuego?",
    "start": 0.2,
    "end": 2.8,
    "shot_anchor": 1,
    "estimated_words": 6,
    "storyboard": "33-1C"
  },
  {
    "source_index": 611,
    "name": "Tiburcio",
    "asset": "Tiburcio常服",
    "kind": "对白",
    "text": "Rojo.",
    "start": 3.6,
    "end": 4.5,
    "shot_anchor": 2,
    "estimated_words": 1,
    "storyboard": "33-1C"
  },
  {
    "source_index": 613,
    "name": "Vera",
    "asset": "Vera黑色晚宴装",
    "kind": "对白",
    "text": "El fuego de una bodega de químicos arde AZUL. Cualquiera que estuvo ahí lo sabe.",
    "start": 5.6,
    "end": 12.0,
    "shot_anchor": 3,
    "estimated_words": 15,
    "storyboard": "33-1C"
  },
  {
    "source_index": 616,
    "name": "Renata",
    "asset": "Renata常服",
    "kind": "对白",
    "text": "¡Los moretones de mi hermana… el taco de billar estaba en SU mano!",
    "start": 3.1,
    "end": 8.8,
    "shot_anchor": 2,
    "estimated_words": 13,
    "storyboard": "33-1D"
  },
  {
    "source_index": 618,
    "name": "Renata",
    "asset": "Renata常服",
    "kind": "对白",
    "text": "¡Él la atacó a ELLA! ¡Yo lo vi con mis propios ojos!",
    "start": 10.1,
    "end": 15.4,
    "shot_anchor": 4,
    "estimated_words": 12,
    "storyboard": "33-1D"
  },
  {
    "source_index": 620,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "¡Renata! ¡SIÉNTATE!",
    "start": 15.6,
    "end": 16.9,
    "shot_anchor": 5,
    "estimated_words": 2,
    "storyboard": "33-1D"
  },
  {
    "source_index": 622,
    "name": "Renata",
    "asset": "Renata常服",
    "kind": "对白",
    "text": "¡La tuvieron encerrada en el ático tres años! ¿Quién de ustedes puede decir que no lo sabía?",
    "start": 17.1,
    "end": 24.3,
    "shot_anchor": 6,
    "estimated_words": 17,
    "storyboard": "33-1D"
  }
]
