[
  {
    "source_index": 8,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Un departamento corporativo. Está vacío.",
    "start": 3.1,
    "end": 5.6,
    "shot_anchor": 2,
    "estimated_words": 5,
    "storyboard": "21-1A"
  },
  {
    "source_index": 10,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "No acepto favores.",
    "start": 6.6,
    "end": 8.1,
    "shot_anchor": 3,
    "estimated_words": 3,
    "storyboard": "21-1A"
  },
  {
    "source_index": 12,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Entonces llámalo inversión.",
    "start": 9.6,
    "end": 11.1,
    "shot_anchor": 4,
    "estimated_words": 3,
    "storyboard": "21-1A"
  },
  {
    "source_index": 14,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "Si pierdes, pierdo mi dinero.",
    "start": 11.3,
    "end": 13.5,
    "shot_anchor": 4,
    "estimated_words": 5,
    "storyboard": "21-1A"
  },
  {
    "source_index": 21,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Bonitos zapatos, por cierto.",
    "start": 6.6,
    "end": 8.4,
    "shot_anchor": 3,
    "estimated_words": 4,
    "storyboard": "21-1B"
  },
  {
    "source_index": 76,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Cuánto tiempo sin verlo.",
    "start": 6.1,
    "end": 7.9,
    "shot_anchor": 3,
    "estimated_words": 4,
    "storyboard": "22-2A"
  },
  {
    "source_index": 78,
    "name": "Escorpión",
    "asset": "Escorpión常服",
    "kind": "对白",
    "text": "Reembolso completo. Me retiro.",
    "start": 9.1,
    "end": 11.2,
    "shot_anchor": 4,
    "estimated_words": 4,
    "storyboard": "22-2A"
  },
  {
    "source_index": 80,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "¡Tres millones de pesos! ¡Eres el limpiador más caro del país!",
    "start": 12.1,
    "end": 17.0,
    "shot_anchor": 5,
    "estimated_words": 11,
    "storyboard": "22-2A"
  },
  {
    "source_index": 83,
    "name": "Escorpión",
    "asset": "Escorpión常服",
    "kind": "对白",
    "text": "Un consejo gratis: huye esta noche. Y no mires atrás.",
    "start": 0.2,
    "end": 4.7,
    "shot_anchor": 1,
    "estimated_words": 10,
    "storyboard": "22-2B"
  },
  {
    "source_index": 85,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "¿Qué es ella?",
    "start": 4.9,
    "end": 6.4,
    "shot_anchor": 2,
    "estimated_words": 3,
    "storyboard": "22-2B"
  },
  {
    "source_index": 87,
    "name": "Escorpión",
    "asset": "Escorpión常服",
    "kind": "对白",
    "text": "Todo lo que sé… me lo enseñó ella.",
    "start": 7.1,
    "end": 10.8,
    "shot_anchor": 3,
    "estimated_words": 8,
    "storyboard": "22-2B"
  },
  {
    "source_index": 110,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Ningún miembro de ninguna familia tocará, investigará ni hará daño a W.",
    "start": 2.6,
    "end": 7.6,
    "shot_anchor": 2,
    "estimated_words": 12,
    "storyboard": "23-1A"
  },
  {
    "source_index": 112,
    "name": "Damián",
    "asset": "Damián常服",
    "kind": "对白",
    "text": "Quien lo viole… lo demás se quemó.",
    "start": 9.6,
    "end": 12.9,
    "shot_anchor": 4,
    "estimated_words": 7,
    "storyboard": "23-1A"
  },
  {
    "source_index": 114,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Tu abuelo la protegió hasta el día que murió.",
    "start": 13.1,
    "end": 16.9,
    "shot_anchor": 5,
    "estimated_words": 9,
    "storyboard": "23-1A"
  },
  {
    "source_index": 117,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Tu abuelo también la investigó. Mira.",
    "start": 0.2,
    "end": 3.1,
    "shot_anchor": 1,
    "estimated_words": 6,
    "storyboard": "23-1B"
  },
  {
    "source_index": 119,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Padres biológicos. Apostadores. Endeudados.",
    "start": 4.1,
    "end": 6.5,
    "shot_anchor": 2,
    "estimated_words": 4,
    "storyboard": "23-1B"
  },
  {
    "source_index": 122,
    "name": "Víctor",
    "asset": "Víctor常服",
    "kind": "对白",
    "text": "Toda navaja tiene mango. Este es el de ella.",
    "start": 10.6,
    "end": 14.7,
    "shot_anchor": 4,
    "estimated_words": 9,
    "storyboard": "23-1B"
  },
  {
    "source_index": 133,
    "name": "Renata",
    "asset": "Renata常服",
    "kind": "对白",
    "text": "La casa del lago. La caja fuerte del abuelo.",
    "start": 0.2,
    "end": 4.3,
    "shot_anchor": 1,
    "estimated_words": 9,
    "storyboard": "23-2B"
  },
  {
    "source_index": 135,
    "name": "Renata",
    "asset": "Renata常服",
    "kind": "对白",
    "text": "Lo agarré y corrí. Mi hermano me persiguió. No volteé.",
    "start": 4.5,
    "end": 9.3,
    "shot_anchor": 2,
    "estimated_words": 10,
    "storyboard": "23-2B"
  },
  {
    "source_index": 145,
    "name": "Emiliano",
    "asset": "Emiliano常服",
    "kind": "对白",
    "text": "¿Es tuya?",
    "start": 3.1,
    "end": 4.2,
    "shot_anchor": 2,
    "estimated_words": 2,
    "storyboard": "23-3A"
  },
  {
    "source_index": 147,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Mi hermana.",
    "start": 6.1,
    "end": 7.2,
    "shot_anchor": 3,
    "estimated_words": 2,
    "storyboard": "23-3A"
  },
  {
    "source_index": 185,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "VO",
    "text": "Los encontré. A sus «papás».",
    "start": 3.1,
    "end": 5.6,
    "shot_anchor": 2,
    "estimated_words": 5,
    "storyboard": "24-3A"
  },
  {
    "source_index": 187,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "VO",
    "text": "Pareja de apostadores. Hace tres días les cayeron quinientos mil pesos en la cuenta.",
    "start": 6.6,
    "end": 12.7,
    "shot_anchor": 3,
    "estimated_words": 14,
    "storyboard": "24-3A"
  },
  {
    "source_index": 189,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿De quién?",
    "start": 13.6,
    "end": 14.7,
    "shot_anchor": 5,
    "estimated_words": 2,
    "storyboard": "24-3A"
  },
  {
    "source_index": 190,
    "name": "Don Ernesto",
    "asset": "Don Ernesto常服",
    "kind": "VO",
    "text": "De una empresa fantasma. De la familia Vargas.",
    "start": 16.6,
    "end": 20.3,
    "shot_anchor": 6,
    "estimated_words": 8,
    "storyboard": "24-3A"
  },
  {
    "source_index": 201,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Número Siete. Abre. Llegaron papá y mamá.",
    "start": 6.1,
    "end": 9.7,
    "shot_anchor": 3,
    "estimated_words": 7,
    "storyboard": "24-4A"
  },
  {
    "source_index": 215,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "Quinientos mil pesos nos dieron por ti.",
    "start": 3.1,
    "end": 6.1,
    "shot_anchor": 2,
    "estimated_words": 7,
    "storyboard": "25-1A"
  },
  {
    "source_index": 217,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "Todos dijeron que nos estafaron.",
    "start": 6.3,
    "end": 8.5,
    "shot_anchor": 2,
    "estimated_words": 5,
    "storyboard": "25-1A"
  },
  {
    "source_index": 220,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Mírate ahora. Vales un millón, mínimo.",
    "start": 8.7,
    "end": 11.6,
    "shot_anchor": 3,
    "estimated_words": 6,
    "storyboard": "25-1A"
  },
  {
    "source_index": 222,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Dinero.",
    "start": 11.8,
    "end": 12.7,
    "shot_anchor": 4,
    "estimated_words": 1,
    "storyboard": "25-1A"
  },
  {
    "source_index": 224,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Un millón de pesos. Llámalo pensión alimenticia.",
    "start": 13.6,
    "end": 16.9,
    "shot_anchor": 5,
    "estimated_words": 7,
    "storyboard": "25-1A"
  },
  {
    "source_index": 226,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Y si no pago?",
    "start": 17.1,
    "end": 18.9,
    "shot_anchor": 6,
    "estimated_words": 4,
    "storyboard": "25-1A"
  },
  {
    "source_index": 228,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Entonces… vamos con la prensa.",
    "start": 0.2,
    "end": 2.7,
    "shot_anchor": 1,
    "estimated_words": 5,
    "storyboard": "25-1B"
  },
  {
    "source_index": 230,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "A decirles que a los ocho años le prendiste fuego a nuestra cocina.",
    "start": 3.1,
    "end": 8.5,
    "shot_anchor": 2,
    "estimated_words": 13,
    "storyboard": "25-1B"
  },
  {
    "source_index": 232,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Tu hermanita casi se muere ahí.",
    "start": 8.7,
    "end": 11.3,
    "shot_anchor": 3,
    "estimated_words": 6,
    "storyboard": "25-1B"
  },
  {
    "source_index": 234,
    "name": "Carmen",
    "asset": "Carmen常服",
    "kind": "对白",
    "text": "Y ya de paso, igual buscamos al viejo amigo de tu hermana.",
    "start": 11.5,
    "end": 16.5,
    "shot_anchor": 4,
    "estimated_words": 12,
    "storyboard": "25-1B"
  },
  {
    "source_index": 237,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "Ustedes saben dónde está mi hermana.",
    "start": 0.2,
    "end": 2.8,
    "shot_anchor": 1,
    "estimated_words": 6,
    "storyboard": "25-1C"
  },
  {
    "source_index": 239,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "¿Quieres saber? Paga.",
    "start": 3.6,
    "end": 5.3,
    "shot_anchor": 2,
    "estimated_words": 3,
    "storyboard": "25-1C"
  },
  {
    "source_index": 250,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "No te voltees. Si te volteas, vas a ver esta cara en cada pesadilla que tengas.",
    "start": 6.1,
    "end": 12.9,
    "shot_anchor": 3,
    "estimated_words": 16,
    "storyboard": "25-2A"
  },
  {
    "source_index": 257,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "¡Ahhh! ¡Alto!",
    "start": 3.1,
    "end": 4.4,
    "shot_anchor": 2,
    "estimated_words": 2,
    "storyboard": "25-2B"
  },
  {
    "source_index": 260,
    "name": "Vera",
    "asset": "Vera常服",
    "kind": "对白",
    "text": "¿Dónde está?",
    "start": 6.1,
    "end": 7.2,
    "shot_anchor": 3,
    "estimated_words": 2,
    "storyboard": "25-2B"
  },
  {
    "source_index": 262,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "Si me la rompes, nunca la vas a encontrar.",
    "start": 9.1,
    "end": 12.9,
    "shot_anchor": 4,
    "estimated_words": 9,
    "storyboard": "25-2B"
  },
  {
    "source_index": 264,
    "name": "Ramón",
    "asset": "Ramón常服",
    "kind": "对白",
    "text": "¡Al sur! ¡La vendimos al sur! A un hombre… ¡con tatuajes rojos en todo el cuello!",
    "start": 13.1,
    "end": 20.5,
    "shot_anchor": 5,
    "estimated_words": 16,
    "storyboard": "25-2B"
  }
]
